{
  "name": "librechat-admin-panel",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "postinstall": "patch-package",
    "reinstall": "rm -rf node_modules && bun pm cache rm && bun install && bun run build",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "bun server.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lint-rules": "node --test tools/eslint-plugin-click-ui/tests/guardrails.test.mjs",
    "test:e2e:ui": "playwright test --ui",
    "sort-imports": "bun run scripts/sort-imports.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}'"
  },
